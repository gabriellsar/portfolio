---
import '@/styles/global.css';
import TmuxBar from '@/components/home/TmuxBar';
import Footer from '@/components/layout/Footer.astro';
import { site } from '@/data/site';
import { getProjects, lite } from '@/lib/projects';

interface Props { title?: string; description?: string; isHome?: boolean; active?: string }
const { title = site.title, description = site.description, isHome = false, active = 'projetos' } = Astro.props;
const projects = (await getProjects()).map(lite);
---
<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0c0d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('gs-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = 'dark'; // dark-first: o claro só aparece se a pessoa escolher
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <TmuxBar client:load isHome={isHome} active={isHome ? 'topo' : active} projects={projects} status={[site.location]} email={site.email} />
    <slot />
    <Footer isHome={isHome} />
  </body>
</html>
