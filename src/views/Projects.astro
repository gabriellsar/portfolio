---
import Layout from '@/layouts/Layout.astro';
import { Card, SectionHeader, Tag } from '@/components/ui';
import { getProjects, anchorOf } from '@/lib/projects';
import { homeHash, projectPath, t, type Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = t(lang);
const all = await getProjects(lang);
---
<Layout lang={lang} title={L.projectsTitle} description={L.projectsDesc} active="projetos">
  <main class="wrap" style="padding-top: 48px; display: flex; flex-direction: column; gap: 32px">
    <a href={homeHash(lang, 'projetos')} class="mono-label link-plain" style="align-self: flex-start; display: inline-flex; align-items: center; min-height: 44px">{L.backHome}</a>
    <SectionHeader as="h1" address="0x01" title={L.allProjects} aside={L.total(String(all.length).padStart(2, '0'))} />
    <div class="pf-cards">
      {all.map(({ data: p, id }) => (
        <div id={anchorOf(p.code)} class="pf-item" style="scroll-margin-top: 56px">
          <Card id={p.code} title={p.title}>
            {(p.destaque || p.status) && (
              <span slot="aside" style="display: flex; flex-wrap: wrap; gap: 6px">
                {p.status && <Tag tone="caution">{L.status[p.status]}</Tag>}
                {p.destaque && <Tag tone="accent">{L.featuredTag}</Tag>}
              </span>
            )}
            <p>{p.desc}</p>
            <div style="display: flex; flex-wrap: wrap; gap: 6px">
              {p.topics.map((t) => <Tag dot={false}>{t}</Tag>)}
            </div>
            <dl class="gs-card-meta"><dt>{L.tech}</dt><dd>{p.base}</dd></dl>
            <div class="pf-cta">
              {p.caseStudy
                ? <a href={projectPath(lang, id)} class="gs-btn gs-btn-primary link-plain">{L.caseStudy} <span class="pf-cta-arrow" aria-hidden="true">→</span></a>
                : <button type="button" class="gs-btn" disabled>{L.caseSoon}</button>}
              {(p.repo || p.app) && (
                <div class="pf-cta-links">
                  {p.repo && <a href={p.repo} class="gs-btn gs-btn-ghost link-plain">{L.code}</a>}
                  {p.app && <a href={p.app} class="gs-btn gs-btn-ghost link-plain">{L.app}</a>}
                </div>
              )}
            </div>
          </Card>
        </div>
      ))}
    </div>
  </main>
</Layout>
