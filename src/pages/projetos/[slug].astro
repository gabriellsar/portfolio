---
import Layout from '@/layouts/Layout.astro';
import { render } from 'astro:content';
import { DataBlock, Tag } from '@/components/ui';
import { getProjects, statusLabel } from '@/lib/projects';

export async function getStaticPaths() {
  const all = await getProjects();
  return all.filter((p) => p.data.caseStudy).map((p) => {
    const i = all.findIndex((x) => x.id === p.id);
    return { params: { slug: p.id }, props: { entry: p, prev: all[i - 1], next: all[i + 1] } };
  });
}

const { entry, prev, next } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);
const linkOf = (e?: typeof entry) => (e ? (e.data.caseStudy ? `/projetos/${e.id}` : `/projetos#${e.data.code.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`) : '/projetos');
---
<Layout title={`${p.title} — estudo de caso · gabriellsar`} description={p.lead ?? p.desc} active="projetos">
  <main class="wrap" style="display: flex; flex-direction: column; gap: 72px">
    <section style="display: flex; flex-direction: column; gap: 32px; padding-top: 48px">
      <a href="/projetos" class="mono-label link-plain" style="align-self: flex-start; display: inline-flex; align-items: center; min-height: 44px">← Todos os projetos</a>
      <div style="display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-end">
        <div style="flex: 1 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
          <p class="mono-label" style="color: var(--accent)">{p.eyebrow ?? p.code}</p>
          <h1 class="study-title" style="margin: 0; font-size: clamp(56px, 8vw, 88px); line-height: 0.98; font-weight: 200; letter-spacing: -0.035em; color: var(--text-strong)">{p.title}</h1>
          <p style="margin: 0; max-width: 600px; font-size: 19px; line-height: 1.6">{p.lead ?? p.desc}</p>
          {(p.tags || p.status) && (
            <div style="display: flex; flex-wrap: wrap; gap: 8px">
              {p.status && <Tag tone="caution">{statusLabel[p.status]}</Tag>}
              {p.tags?.map((t) => <Tag tone={t.tone}>{t.label}</Tag>)}
            </div>
          )}
          {(p.repo || p.app) && (
            <div style="display: flex; flex-wrap: wrap; gap: 8px">
              {p.app && <a href={p.app} class="gs-btn gs-btn-primary link-plain">Abrir o app ↗</a>}
              {p.repo && <a href={p.repo} class="gs-btn gs-btn-ghost link-plain">Código ↗</a>}
            </div>
          )}
        </div>
        {p.ficha && (
          <div style="flex: 0 1 400px; min-width: min(300px, 100%)">
            <DataBlock title="FICHA" rows={p.ficha} />
          </div>
        )}
      </div>

      {p.figura && (
        <figure style="position: relative; margin: 0; display: flex; flex-direction: column; gap: 12px">
          {p.figura.src
            ? <img src={p.figura.src} alt={p.figura.alt} style="display: block; width: 100%; height: auto; border: 1px solid var(--line-strong)" />
            : (
              <div class="fig-grid" style="position: relative; aspect-ratio: 16 / 9; max-height: 520px; border: 1px solid var(--line-strong); background-color: var(--surface); display: flex; align-items: center; justify-content: center">
                <span aria-hidden="true" class="gs-card-mark"></span>
                <p style="margin: 0; padding: 8px 14px; background: var(--bg); border: 1px solid var(--line-strong); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; color: var(--muted)">[CAPTURA DO APP · 1600×900]</p>
              </div>
            )}
          <figcaption style="display: flex; justify-content: space-between; gap: 12px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; color: var(--muted)">
            <span>{p.figura.legenda}</span>{p.figura.data && <span>{p.figura.data}</span>}
          </figcaption>
        </figure>
      )}
    </section>

    <Content />

    <nav aria-label="Outros projetos" style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px; padding: 24px 0 0; border-top: 1px solid var(--line)">
      {prev ? (
        <a href={linkOf(prev)} class="link-plain" style="display: flex; flex-direction: column; gap: 6px">
          <span class="mono-label" style="font-size: 11px">← Anterior · {prev.data.code}</span>
          <span style="font-size: 28px; font-weight: 300; color: var(--text-strong)">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next && (
        <a href={linkOf(next)} class="link-plain" style="display: flex; flex-direction: column; gap: 6px; text-align: right">
          <span class="mono-label" style="font-size: 11px">Próximo · {next.data.code} →</span>
          <span style="font-size: 28px; font-weight: 300; color: var(--text-strong)">{next.data.title}</span>
        </a>
      )}
    </nav>
  </main>
</Layout>
