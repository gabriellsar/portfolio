---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="404 — gabriel.s" active="">
  <main class="wrap" style="min-height: 60vh; display: flex; flex-direction: column; justify-content: center; gap: 20px; padding-top: 72px">
    <p class="prompt"><span class="user">gabriel@arch</span><span class="path">:~$</span> cd {Astro.url.pathname}</p>
    <p class="prompt" style="color: var(--signal)">cd: no such file or directory</p>
    <h1 class="hero-name">404<span class="hero-cursor blink" aria-hidden="true"></span></h1>
    <p style="margin: 0; max-width: 520px; font-size: 18px; line-height: 1.6">Essa página não existe. Volte para a home ou abra o terminal com <span style="font-family: var(--font-mono); color: var(--accent)">:</span> e digite <span style="font-family: var(--font-mono); color: var(--accent)">help</span>.</p>
    <div style="display: flex; flex-wrap: wrap; gap: 12px">
      <a href="/" class="gs-btn gs-btn-primary link-plain">cd ~</a>
      <a href="/projetos" class="gs-btn link-plain">ls ./projetos</a>
    </div>
  </main>
</Layout>
